                            "formdata": [
                                {
                                    "key": "media",
                                    "type": "file",
                                    "src": []
                                },
                                {
                                    "key": "body",
                                    "value": "This is a post",
                                    "type": "text"
                                },
                                {
                                    "key": "postType",
                                    "value": "normal",
                                    "type": "text"
                                },
                                {
                                    "key": "target",
                                    "value": "1",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/app/create-post"
