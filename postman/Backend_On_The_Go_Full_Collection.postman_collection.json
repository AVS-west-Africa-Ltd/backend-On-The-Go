{
    "info": {
        "name": "Backend On-The-Go API",
        "description": "Complete API collection for the Backend On-The-Go project, including Auth, Profile, App, Community, Branch, Product, Order, and Admin modules.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"1234567890\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/register"
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/login"
                    }
                },
                {
                    "name": "Verify Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"token\": \"123456\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/verify-email"
                    }
                },
                {
                    "name": "Send Verification Code",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john@example.com\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/send-code"
                    }
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\",\n  \"password\": \"newPassword123\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/reset-password"
                    }
                },
                {
                    "name": "Complete Invite",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"token\": \"inviteToken\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/complete-invite"
                    }
                }
            ]
        },
        {
            "name": "Profile",
            "item": [
                {
                    "name": "Fetch Profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/profile/fetch"
                    }
                },
                {
                    "name": "Create Profile",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "picture",
                                    "type": "file",
                                    "src": []
                                },
                                {
                                    "key": "username",
                                    "value": "johndoe",
                                    "type": "text"
                                },
                                {
                                    "key": "bio",
                                    "value": "Hello world",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/profile/create"
                    }
                },
                {
                    "name": "Add More Information",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"additionalInfo\": \"Data\"\n}"
                        },
                        "url": "{{baseUrl}}/profile/add-more-information"
                    }
                },
                {
                    "name": "Add Photos",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "photos",
                                    "type": "file",
                                    "src": []
                                },
                                {
                                    "key": "targetType",
                                    "value": "profile",
                                    "type": "text"
                                },
                                {
                                    "key": "targetId",
                                    "value": "1",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/profile/add-photos"
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "picture",
                                    "type": "file",
                                    "src": []
                                },
                                {
                                    "key": "bio",
                                    "value": "Updated bio",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/profile/update"
                    }
                },
                {
                    "name": "Add Socials",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"socials\": {\n    \"instagram\": \"@john\",\n    \"twitter\": \"@john\"\n  }\n}"
                        },
                        "url": "{{baseUrl}}/profile/socials"
                    }
                }
            ]
        },
        {
            "name": "App",
            "item": [
                {
                    "name": "Create Post",
                    "request": {
                        "method": "POST",
                        "header": [
