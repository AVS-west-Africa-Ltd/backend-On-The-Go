                },
                {
                    "name": "Fetch Posts",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/app/fetch-posts?limit=20&offset=0Type",
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "offset",
                                    "value": "0"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Search Businesses",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/app/fetch-businesses?search=cafe",
                            "query": [
                                {
                                    "key": "search",
                                    "value": "cafe"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Fetch Chats",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/app/fetch-chats"
                    }
                }
            ]
        },
